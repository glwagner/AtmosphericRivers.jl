#!/bin/bash
#SBATCH --job-name=ar-optcol
#SBATCH --gpus=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=150G
#SBATCH --time=03:00:00
#SBATCH --output=slurm/%x-%j.log

# perf/opt_column_bench.jl in the production forward configuration (same setup as slurm/perf_window.batch).
# OPT_PROJECT selects the environment, OPT_DEPOT the first (writable) depot, OPT_TAG the output tag.
cd "$SLURM_SUBMIT_DIR"
export JULIA_DEPOT_PATH="${OPT_DEPOT:-$HOME/.julia-perf}:$HOME/.julia-perf:$HOME/.julia-975:$HOME/.julia-prod:$HOME/.julia"
export JULIA_NUM_PRECOMPILE_TASKS=${SLURM_CPUS_PER_TASK:-12}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK:-12}
export HDF5_USE_FILE_LOCKING=FALSE
JULIA=~/.juliaup/bin/julia
PROJECT=${OPT_PROJECT:-$HOME/AtmosphericRivers-perf/env-975-prs}
GPU=$(nvidia-smi --query-gpu=name --format=csv,noheader | head -1 | awk '{print $2}')
nvidia-smi --query-gpu=name --format=csv,noheader

DT=${AR_DT:-10}
export AR_ARCH=cuda AR_DOMAIN=landfall AR_CELLS_PER_DEGREE=${AR_CELLS_PER_DEGREE:-9}
export AR_PARENT=era5 AR_PARENT_HOURS=${AR_PARENT_HOURS:-2} AR_ERA5_REGION=-170.5,-109.5,24.5,60.5
export AR_PARENT_UNIFORM_Z=1 AR_PARENT_PRESSURE=${AR_PARENT_PRESSURE:-column} AR_IC=interpolated AR_BALANCER=0
export AR_COUPLED=1 AR_FLUX_ITERATIONS=10 AR_RADIATION=1 AR_RADIATION_EVERY=$(( 3600 / DT ))
export AR_SOLAR=apparent AR_SST=${AR_SST:-era5}
export AR_TERRAIN=etopo AR_TERRAIN_SMOOTHING=${AR_TERRAIN_SMOOTHING:-2}
export AR_DT=$DT AR_STEPS=10 AR_CHUNK=10 AR_SPONGE=1 AR_OUTPUT=0
export AR_CLOSURE=${AR_CLOSURE:-tke} AR_TKE_FLAVOR=${AR_TKE_FLAVOR:-default}
TAG=${OPT_TAG:-base}_$GPU
env | grep -E '^(AR_|OPT_|BREEZE_)' | sort
echo "=== [$(date -Is)] project $PROJECT, depot $JULIA_DEPOT_PATH, tag $TAG ==="

$JULIA --startup-file=no --project=$PROJECT -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()' || exit 1
echo "=== [$(date -Is)] precompiled ==="
AR_BENCH_OUT=perf/data/optcol_$TAG stdbuf -oL -eL $JULIA --startup-file=no --project=$PROJECT -t auto perf/opt_column_bench.jl
echo "=== [$(date -Is)] done (exit $?) ==="
