#!/bin/bash
#SBATCH --job-name=ar-e2e
#SBATCH --gpus=1
#SBATCH --cpus-per-task=12
#SBATCH --mem=150G
#SBATCH --time=03:00:00
#SBATCH --output=slurm/%x-%j.log

# End-to-end wall time of the production 24 h 12 km forward run (perf/e2e_run.jl, with the setup-phase
# sampler), in the configuration of perf/PROFILE_REPORT.md: #975 default TKE, column parent pressure,
# real sun, ERA5 SST, ETOPO s2, coupled, Δt = 10 s, 48 snapshots + the initial one.
#
#   sbatch -p gpua100 --export=ALL,AR_E2E_TAG=sync slurm/e2e.batch
#   sbatch -p gpua100 --export=ALL,AR_E2E_TAG=async,AR_ASYNC_OUTPUT=1 slurm/e2e.batch
#   sbatch -p gpua100 --export=ALL,AR_E2E_TAG=multi,AR_MULTI_CONFIGS="AR_TKE_FLAVOR=default&AR_OUTPUT_FILE=a.jld2;AR_TKE_FLAVOR=catke&AR_OUTPUT_FILE=b.jld2" slurm/e2e.batch
#
# AR_E2E_PROJECT picks the Julia project, AR_E2E_DEPOT the first (writable) depot.
cd "$SLURM_SUBMIT_DIR"
export JULIA_DEPOT_PATH="${AR_E2E_DEPOT:-$HOME/.julia-opt-e2e}:$HOME/.julia-perf:$HOME/.julia-975:$HOME/.julia-prod:$HOME/.julia"
export JULIA_NUM_PRECOMPILE_TASKS=${SLURM_CPUS_PER_TASK:-12}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK:-12}
export HDF5_USE_FILE_LOCKING=FALSE
JULIA=~/.juliaup/bin/julia
PROJECT=${AR_E2E_PROJECT:-$HOME/AtmosphericRivers-opt-e2e/env}
nvidia-smi --query-gpu=name --format=csv,noheader
lscpu | grep "Model name"

DT=${AR_DT:-10}
HOURS=${AR_RUN_HOURS:-24}
TAG=${AR_E2E_TAG:-e2e}
export AR_ARCH=cuda AR_DOMAIN=landfall AR_CELLS_PER_DEGREE=9
export AR_PARENT=era5 AR_PARENT_HOURS=$(( HOURS + 1 )) AR_ERA5_REGION=-170.5,-109.5,24.5,60.5
export AR_PARENT_UNIFORM_Z=1 AR_PARENT_PRESSURE=${AR_PARENT_PRESSURE:-column} AR_IC=interpolated AR_BALANCER=0
export AR_COUPLED=1 AR_FLUX_ITERATIONS=10 AR_RADIATION=1 AR_RADIATION_EVERY=$(( 3600 / DT ))
export AR_SOLAR=apparent AR_SST=${AR_SST:-era5}
export AR_TERRAIN=etopo AR_TERRAIN_SMOOTHING=${AR_TERRAIN_SMOOTHING:-2}
export AR_DT=$DT AR_STEPS=$(( HOURS * 3600 / DT )) AR_CHUNK=$(( 1800 / DT )) AR_SPONGE=1
export AR_CLOSURE=${AR_CLOSURE:-tke} AR_TKE_FLAVOR=${AR_TKE_FLAVOR:-default} AR_OUTPUT_CLOSURE=1
export AR_OUTPUT=1 AR_OUTPUT_FILE=${AR_OUTPUT_FILE:-runs/e2e/${TAG}_${SLURM_JOB_ID}.jld2}
mkdir -p runs/e2e perf/data
env | grep '^AR_' | sort
echo "=== [$(date -Is)] project $PROJECT, depot $JULIA_DEPOT_PATH ==="

if [ "${AR_E2E_INSTANTIATE:-0}" = "1" ]; then
    $JULIA --startup-file=no --project=$PROJECT -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()' || exit 1
    echo "=== [$(date -Is)] instantiated ==="
fi

echo "julia_launch_unix $(date +%s.%N)"
AR_E2E_OUT=perf/data/e2e_${TAG}_${SLURM_JOB_ID} \
    stdbuf -oL -eL $JULIA --startup-file=no --project=$PROJECT -t auto perf/e2e_run.jl
status=$?
echo "julia_exit_unix $(date +%s.%N)"
echo "=== [$(date -Is)] done (exit $status) ==="
exit $status
